PORT=3001
JWT_SECRET=troque-este-segredo-em-producao
CORS_ORIGIN=http://localhost:5173

# Web Push — gere as suas com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Notificação diária de contas vencendo hoje (formato cron + timezone IANA)
NOTIFICATION_CRON=0 8 * * *
NOTIFICATION_TZ=America/Sao_Paulo

# OCR (lançamento por foto) — obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Segredo para o agendador externo disparar a checagem diária — gere com:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
